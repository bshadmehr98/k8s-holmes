{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv sync*)",
      "Bash(uv run*)",
      "Bash(scripts/check.sh)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl events*)",
      "Bash(kubectl top*)",
      "Bash(kubectl config get-contexts*)",
      "Bash(kubectl config current-context*)",
      "Bash(kubectl version*)",
      "Bash(kubectl api-resources*)",
      "Bash(kubectl auth can-i*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)"
    ],
    "deny": [
      "Bash(uv publish*)",
      "Bash(twine*)",
      "Bash(uv run*twine*)",
      "Bash(uv run*uv publish*)",
      "Bash(uvx twine*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl create*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl replace*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl drain*)",
      "Bash(kubectl cordon*)",
      "Bash(kubectl taint*)",
      "Bash(kubectl exec*)",
      "Bash(kubectl debug*)",
      "Bash(kubectl cp*)",
      "Bash(kubectl config use-context*)",
      "Bash(kubectl config set*)",
      "Bash(kubectl config delete*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-python.sh" }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git push*)", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-push.sh" },
          { "type": "command", "if": "Bash(gh pr create*)", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-push.sh" }
        ]
      }
    ]
  }
}
